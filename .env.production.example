# ==============================================================================
# WP-9 Production Environment Configuration Template
# ==============================================================================

# Core Application
NODE_ENV=production
HOST=0.0.0.0
PORT=43217
WORKER_PORT=8788
WORKER_API_SECRET=your_long_random_worker_secret_key_here

# Domain & SSL (Caddy)
DOMAIN=yourdomain.com
KUMA_DOMAIN=kuma.yourdomain.com
N8N_DOMAIN=n8n.yourdomain.com
ACME_EMAIL=your-email@example.com

# PostgreSQL CRM Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_strong_postgres_password_here
POSTGRES_DB=wp9
DATABASE_URL=postgres://postgres:generate_strong_postgres_password_here@postgres:5432/wp9

# Redis Cache & Queue
REDIS_URL=redis://redis:6379

# Vector DB (Qdrant)
QDRANT_URL=http://qdrant:6333

# AI Model Providers (Multi-Model Router)
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Automation (n8n)
N8N_HOST=n8n.yourdomain.com
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/

# Evolution API (Optional Alternate WhatsApp Engine Profile)
EVOLUTION_API_KEY=generate_evolution_secret_api_key_here
