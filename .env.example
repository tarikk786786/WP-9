# ==============================================================================
# WP-9 Production Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
WORKER_PORT=8788
PORT=8788

# Dedicated persistent directory for Baileys WhatsApp credentials on VM/Docker
# Must survive restarts, reboots, and redeploys.
BAILEYS_AUTH_DIR=/app/data/baileys-auth

# ------------------------------------------------------------------------------
# 2. VERCEL <-> WORKER SECURE COMMUNICATIONS
# ------------------------------------------------------------------------------
# On Vercel: Set WORKER_API_URL to your Cloudflare Named Tunnel public hostname
# Example: https://worker.yourdomain.com
WORKER_API_URL=https://worker.yourdomain.com

# Timing-safe shared secret used to authenticate Vercel dashboard commands to worker
WORKER_API_SECRET=wp9_sec_9114411026_daziai_crm

# Public worker hostname broadcast in telemetry & heartbeats
PUBLIC_WORKER_URL=https://worker.yourdomain.com

# Vercel Admin Dashboard password
ADMIN_SECRET=change-me-admin-password
NEXT_PUBLIC_APP_URL=https://daziai-whatsapp-crm.vercel.app

# ------------------------------------------------------------------------------
# 3. SUPABASE CLOUD (Durable State, pgvector, and Backups)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE NAMED TUNNEL (Zero-Trust Ingress)
# ------------------------------------------------------------------------------
# Never use trycloudflare in production. Use a Named Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# ------------------------------------------------------------------------------
# 5. MULTI-MODEL AI ROUTER & INTELLIGENCE
# ------------------------------------------------------------------------------
AI_POLICY=hybrid
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED TELEMETRY & ERROR TRACKING (Optional)
# ------------------------------------------------------------------------------
SENTRY_DSN=
