# Supabase (required for production persistence)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI / Groq / Anthropic / Gemini / OpenRouter / Together / Cerebras
# Hybrid policy: cheap/fast first, strongest model when the message is a real lead.
AI_POLICY=hybrid
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
AI_PROVIDER_ORDER=

# Persistent Baileys worker (NOT Vercel)
WORKER_API_URL=http://127.0.0.1:8788
WORKER_API_SECRET=change-me-long-random-secret
WORKER_PORT=8788

# Next.js / Vercel
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43217
ADMIN_SECRET=change-me-admin-password

# Optional
SENTRY_DSN=
