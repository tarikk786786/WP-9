# WhatsApp Cloud API (Meta). Leave empty to use the local simulator.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=relay-verify-change-me
WHATSAPP_APP_SECRET=

# Optional: durable rules on Vercel (paste JSON copied from the dashboard).
# REPLY_RULES_JSON=

# Optional: restore a WhatsApp Web login on a new machine (local/VPS only).
# Do not commit this. Created automatically as data/whatsapp-session.json after QR.
# WHATSAPP_AUTH_JSON=
